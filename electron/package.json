{
  "name": "openagent-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Native desktop interface for openagent",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "renderer:dev": "vite --config renderer-src/vite.config.mts",
    "renderer:build": "vite build --config renderer-src/vite.config.mts",
    "dev": "electron .",
    "test": "node --experimental-strip-types --test tests/all.mts",
    "test:vault": "node tests/run-os-vault.cjs",
    "test:preload": "node tests/run-preload-bridge.cjs",
    "test:theme": "node tests/run-theme-visual.cjs",
    "test:sidebar": "node tests/run-sidebar-visual.cjs",
    "test:chat": "node tests/run-chat-visual.cjs",
    "test:stop": "node tests/run-stop-visual.cjs",
    "test:permission": "node tests/run-permission-visual.cjs",
    "test:layout": "node tests/run-layout-visual.cjs",
    "test:settings": "node tests/run-settings-visual.cjs",
    "test:settings-tabs": "node tests/run-settings-tabs-visual.cjs",
    "test:settings-folder": "node tests/run-settings-folder-danger-visual.cjs",
    "test:model": "node tests/run-model-selector-visual.cjs",
    "test:branches": "node tests/run-branches-visual.cjs",
    "test:context": "node tests/run-context-visual.cjs",
    "test:prompts": "node tests/run-prompts-visual.cjs",
    "test:palette": "node tests/run-palette-visual.cjs",
    "package:win": "npm run renderer:build && electron-builder --win dir",
    "test:package": "node tests/package-smoke.cjs",
    "test:final-e2e": "node tests/final-e2e.cjs",
    "test:final-e2e-lot2": "node tests/final-e2e-lot2.cjs",
    "test:final-e2e-lot3": "node tests/final-e2e-lot3.cjs",
    "test:final-e2e-lot4": "node tests/final-e2e-lot4.cjs",
    "test:final-e2e-lot5": "node tests/final-e2e-lot5.cjs",
    "test:final-e2e-lot6": "node tests/final-e2e-lot6.cjs",
    "test:final-e2e-lot7": "node tests/final-e2e-lot7.cjs",
    "test:bridge-real": "node tests/bridge-real.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.openagent.desktop",
    "productName": "openagent",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "worker.mjs",
      "core/**/*",
      "renderer-dist/**/*",
      "package.json",
      "!**/*.test.mts",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "dir"
    }
  }
}
